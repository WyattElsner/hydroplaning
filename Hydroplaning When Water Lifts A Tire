<script>
(function(){
var rho=998, mu=1.002e-3, b=0.205, Lp=0.15;
var units='SI', state='rolling';
var $=function(id){return document.getElementById(id)};
var pt=$('pt'), spd=$('spd'), film=$('film'), tread=$('tread');
function fmt(n,d){return n.toLocaleString('en-US',{maximumFractionDigits:d,minimumFractionDigits:d})}
function sci(n){var e=n.toExponential(1).split('e');return fmt(parseFloat(e[0]),1)+' × 10^'+e[1].replace('+','')}
function fillTrack(el){var min=parseFloat(el.min),max=parseFloat(el.max),v=parseFloat(el.value);var p=((v-min)/(max-min))*100;el.style.background='linear-gradient(to right, var(--accent) 0%, var(--accent) '+p+'%, var(--line) '+p+'%, var(--line) 100%)';}
function render(){
  var P=parseFloat(pt.value), Vkmh=parseFloat(spd.value), h=parseFloat(film.value), tr=parseFloat(tread.value);
  var V=Vkmh/3.6, CLh=(state==='rolling'?0.7:0.95);
  [pt,spd,film,tread].forEach(fillTrack);
  if(units==='SI'){
    $('ptVal').textContent=fmt(P,0)+' kPa'; $('spdVal').textContent=fmt(Vkmh,0)+' km/h';
    $('filmVal').textContent=fmt(h,1)+' mm'; $('treadVal').textContent=fmt(tr,1)+' mm';
  }else{
    $('ptVal').textContent=fmt(P/6.89476,1)+' psi'; $('spdVal').textContent=fmt(Vkmh/1.60934,1)+' mph';
    $('filmVal').textContent=fmt(h/25.4,3)+' in'; $('treadVal').textContent=fmt(tr/25.4,3)+' in';
  }
  var q=0.5*rho*V*V/1000;
  var lift=CLh*q;
  var nasaR=6.36*Math.sqrt(P), nasaN=5.43*Math.sqrt(P);
  var nasaSel=(state==='rolling'?nasaR:nasaN);
  var stateName=(state==='rolling'?'rolling':'non-rotating');
  var bal=Math.sqrt(2*P*1000/(rho*CLh))*3.6;
  var margin=nasaSel-Vkmh;
  var ReH=rho*V*(h/1000)/mu, ReP=rho*V*Lp/mu;
  var Qw=V*b*(h/1000)*1000;
  function spdOut(kmh){return units==='SI'?fmt(kmh,1)+' km/h':fmt(kmh/1.60934,1)+' mph'}
  function prOut(kpa){return units==='SI'?fmt(kpa,0)+' kPa':fmt(kpa/6.89476,1)+' psi'}
  $('oQ').textContent=prOut(q);
  $('oLift').textContent=prOut(lift);
  $('oNasaR').textContent=spdOut(nasaR);
  $('oNasaN').textContent=spdOut(nasaN);
  $('oBal').textContent=spdOut(bal);
  var marginTxt=(margin>=0?'+':'')+(units==='SI'?fmt(margin,1)+' km/h':fmt(margin/1.60934,1)+' mph');
  $('oMargin').textContent=marginTxt;
  $('oMarginBig').textContent=marginTxt;
  $('oCrit').textContent=spdOut(nasaSel);
  $('oReH').textContent=sci(ReH); $('oReP').textContent=sci(ReP);
  $('oQw').textContent=fmt(Qw,1)+' L/s';
  $('treadWarn').hidden=!(h>tr);
  var pavKmh=null;
  if(h<2.4){ var wft0=h/25.4; pavKmh=26.04*Math.pow(wft0,-0.259)*1.60934; }
  var ctrl=(pavKmh===null)?nasaSel:Math.min(nasaSel,pavKmh);
  $('oCtrl').textContent=spdOut(ctrl);
  if(pavKmh===null){
    $('oCtrlSrc').innerHTML='<strong>Which limit controls:</strong> the NASA '+stateName+' estimate — the film is 2.4 mm or deeper, so the thin-film PAVDRN model does not apply here.';
  }else if(pavKmh<nasaSel){
    $('oCtrlSrc').innerHTML='<strong>Which limit controls:</strong> PAVDRN — on a thin film ('+fmt(h,1)+' mm, under 2.4 mm) it predicts lift-off sooner than NASA, so its lower speed is the one to watch.';
  }else{
    $('oCtrlSrc').innerHTML='<strong>Which limit controls:</strong> the NASA '+stateName+' estimate — even on this thin film it is lower than the PAVDRN speed, so it controls.';
  }
  $('chartTreadWarn').hidden=!(h>tr);
  $('chartPavNote').textContent=(pavKmh===null)
    ? 'Thin-film note: at h = '+fmt(h,1)+' mm the PAVDRN thin-film model does not apply (it is only valid below 2.4 mm), so no PAVDRN marker is shown. Tread depth does not change these curves — it only triggers the warning above when the water is deeper than the tread.'
    : 'Thin-film note: the blue dotted marker is the PAVDRN onset for h = '+fmt(h,1)+' mm — drag the film slider and watch it move. Tread depth does not change these curves; it only triggers a warning when the water is deeper than the tread.';
  $('oLiftBig').textContent=prOut(lift);
  $('oLiftSub').textContent='Tyre pressure is '+prOut(P)+' — lift is '+(lift>=P?'above it, so the lift balance says the tyre is lifted':'below it, so the tyre still carries its load');
  var sb=$('statusBox'), sd=$('statusDetail');
  if(margin>10){sb.className='status-pill ok'; sb.textContent='Below estimated onset'; sd.textContent='Driving speed is more than 10 km/h under the NASA '+stateName+' estimate for the selected tyre state ('+spdOut(nasaSel)+').';}
  else if(margin>0){sb.className='status-pill near'; sb.textContent='Near onset — reduce speed'; sd.textContent='Within 10 km/h of the NASA '+stateName+' estimate for the selected tyre state ('+spdOut(nasaSel)+').';}
  else{sb.className='status-pill over'; sb.textContent='At or above estimated onset'; sd.textContent='At or past the NASA '+stateName+' estimate for the selected tyre state ('+spdOut(nasaSel)+'). Lift pressure '+(lift>=P?'exceeds':'approaches')+' tyre pressure in the lift-balance check.';}
  // Live visual: water depth, wedge size, tyre lift, speed label
  var waterH=4+Math.min(h,10)*1.6;
  var water=$('vizWater'); water.setAttribute('y',(132-waterH).toFixed(1)); water.setAttribute('height',waterH.toFixed(1));
  var wedge=$('vizWedge'); var wy=132-waterH-2; wedge.setAttribute('d','M 90 132 L 330 132 L 330 '+wy.toFixed(1)+' L 150 '+(132-waterH*0.4).toFixed(1)+' Z');
  var liftFrac=Math.max(0,Math.min(1,(lift-P)/160+0.5)); var liftPx=(lift>=P)?Math.min(16,4+(lift-P)/12):0;
  $('vizTyre').style.transform='translateY('+(-liftPx).toFixed(1)+'px)';
  $('vizSpeed').textContent=(units==='SI'?fmt(Vkmh,0)+' km/h':fmt(Vkmh/1.60934,1)+' mph');
  $('vizLift').textContent=lift>=P?'▲ lift exceeds p_t — tyre lifted':'';
  $('vizCap').textContent='Live view — film '+fmt(h,1)+' mm · wedge grows with speed · '+(lift>=P?'tyre lifted off the road':'tyre in contact');
  var pp=$('pavPanel');
  if(pavKmh!==null){
    pp.hidden=false;
    pp.innerHTML='<strong>Thin-film panel — PAVDRN applies (h = '+fmt(h,1)+' mm &lt; 2.4 mm).</strong><br>PAVDRN speed: <strong>'+spdOut(pavKmh)+'</strong> · NASA '+stateName+' (selected state): <strong>'+spdOut(nasaSel)+'</strong><br>Controlling speed (min of the two): <strong>'+spdOut(ctrl)+'</strong>, from '+(ctrl===pavKmh?'PAVDRN':'NASA '+stateName)+'. PAVDRN is not extrapolated beyond 2.4 mm.';
  } else { pp.hidden=true; pp.innerHTML=''; }
  drawChart(P,Vkmh,CLh,lift,pavKmh,stateName);
}
function drawChart(P,Vcur,CLh,liftCur,pavKmh,stateName){
  var svg=$('chart'), W=720,H=224, L=52,Rt=126,T=20,B=36, iw=W-L-Rt, ih=H-T-B, maxV=140, maxP=800;
  function X(v){return L+iw*v/maxV} function Y(p){return T+ih-ih*p/maxP}
  function qAt(v,clh){var ms=v/3.6; return 0.5*rho*ms*ms/1000*clh}
  var cross=Math.sqrt(2*P*1000/(rho*CLh))*3.6;
  var s='';
  // Shaded onset region: where the lift curve sits above p_t (past the crossing)
  if(cross<maxV){
    var shade='M'+X(cross).toFixed(1)+' '+Y(P).toFixed(1)+' ';
    for(var v=cross;v<=maxV;v+=2){shade+='L'+X(v).toFixed(1)+' '+Y(Math.min(qAt(v,CLh),maxP)).toFixed(1)+' ';}
    shade+='L'+X(maxV).toFixed(1)+' '+Y(P).toFixed(1)+' Z';
    s+='<path d="'+shade+'" fill="var(--orange)" opacity="0.16"/>';
    s+='<text x="'+((X(cross)+X(maxV))/2).toFixed(1)+'" y="'+(Y(P)-10)+'" font-size="14" text-anchor="middle" fill="var(--orange)" font-weight="700">lift above p_t — past onset</text>';
  }
  // Gridlines and axis ticks (14px minimum)
  for(var g=0;g<=maxP;g+=200){s+='<line x1="'+L+'" y1="'+Y(g)+'" x2="'+(L+iw)+'" y2="'+Y(g)+'" stroke="var(--line)" stroke-width="1"/><text x="'+(L-8)+'" y="'+(Y(g)+5)+'" font-size="14" text-anchor="end" fill="var(--muted)">'+g+'</text>';}
  for(var v=0;v<=140;v+=20){s+='<line x1="'+X(v)+'" y1="'+T+'" x2="'+X(v)+'" y2="'+(T+ih)+'" stroke="var(--line)" stroke-width="0.6" opacity="0.6"/><text x="'+X(v)+'" y="'+(H-24)+'" font-size="14" text-anchor="middle" fill="var(--muted)">'+v+'</text>';}
  s+='<text x="'+(L+iw/2)+'" y="'+(H-6)+'" font-size="14" text-anchor="middle" fill="var(--ink)" font-weight="600">Speed V (km/h)</text>';
  s+='<text x="18" y="'+(T+ih/2)+'" font-size="14" text-anchor="middle" fill="var(--ink)" font-weight="600" transform="rotate(-90 18 '+(T+ih/2)+')">Pressure (kPa)</text>';
  // PAVDRN thin-film marker (only when h < 2.4 mm)
  if(pavKmh!==null&&pavKmh<=maxV){
    s+='<line x1="'+X(pavKmh)+'" y1="'+T+'" x2="'+X(pavKmh)+'" y2="'+(T+ih)+'" stroke="var(--water)" stroke-width="2.5" stroke-dasharray="2 5"/>';
    var pavAnchor=pavKmh>92?'end':'start'; var pavX=pavKmh>92?X(pavKmh)-6:X(pavKmh)+6;
    s+='<text x="'+pavX+'" y="'+(T-8)+'" font-size="14" text-anchor="'+pavAnchor+'" fill="var(--water)" font-weight="700">PAVDRN thin-film onset · '+fmt(pavKmh,1)+' km/h</text>';
  }
  // Curves: q dashed grey, lift solid teal — told apart by dash as well as colour
  function curve(clh,color,width,dash){
    var d=''; for(var v=0;v<=140;v+=2){var q=Math.min(qAt(v,clh),maxP); d+=(v===0?'M':'L')+X(v).toFixed(1)+' '+Y(q).toFixed(1)+' ';} return '<path d="'+d+'" fill="none" stroke="'+color+'" stroke-width="'+width+'"'+(dash?' stroke-dasharray="'+dash+'"':'')+'/>';
  }
  s+=curve(1,'#8a949e',2.5,'6 4');
  s+=curve(CLh,'var(--accent)',3.5,'');
  // p_t dashed horizontal line
  s+='<line x1="'+L+'" y1="'+Y(P)+'" x2="'+(L+iw)+'" y2="'+Y(P)+'" stroke="var(--orange)" stroke-width="2.5" stroke-dasharray="9 5"/>';
  // Crossing point where lift meets p_t
  if(cross<=maxV){s+='<circle cx="'+X(cross)+'" cy="'+Y(P)+'" r="6" fill="var(--surface)" stroke="var(--orange)" stroke-width="3"/>';}
  // Current-speed marker: vertical line, dot on the lift curve, plain label
  if(Vcur>0&&Vcur<=maxV){
    s+='<line x1="'+X(Vcur)+'" y1="'+T+'" x2="'+X(Vcur)+'" y2="'+(T+ih)+'" stroke="var(--ink)" stroke-width="2"/>';
    s+='<circle cx="'+X(Vcur)+'" cy="'+Y(Math.min(liftCur,maxP))+'" r="7" fill="var(--accent)" stroke="var(--surface)" stroke-width="2.5"/>';
    var youAnchor=Vcur>84?'end':'start'; var youX=Vcur>84?X(Vcur)-10:X(Vcur)+10;
    var youY=Math.max(T+16,Y(Math.min(liftCur,maxP))-14);
    s+='<text x="'+youX+'" y="'+youY+'" font-size="14" text-anchor="'+youAnchor+'" fill="var(--ink)" font-weight="700">You: '+fmt(Vcur,0)+' km/h · lift '+fmt(liftCur,0)+' kPa — '+(liftCur>=P?'above':'below')+' p_t</text>';
  }
  // Direct end-of-line labels (right margin, stacked so they never overlap)
  var qEndY=Y(Math.min(qAt(140,1),maxP)), liftEndY=Y(Math.min(qAt(140,CLh),maxP));
  s+='<text x="'+(L+iw+8)+'" y="'+(qEndY+5)+'" font-size="14" fill="#8a949e" font-weight="700">q (dashed)</text>';
  s+='<text x="'+(L+iw+8)+'" y="'+(liftEndY+24)+'" font-size="14" fill="var(--accent)" font-weight="700">lift (solid)</text>';
  s+='<text x="'+(L+iw+8)+'" y="'+(liftEndY+44)+'" font-size="14" fill="var(--accent)">'+stateName+'</text>';
  s+='<text x="'+(L+iw+8)+'" y="'+(liftEndY+64)+'" font-size="14" fill="var(--accent)">C_Lh = '+CLh+'</text>';
  s+='<text x="'+(L+iw+8)+'" y="'+(Y(P)+5)+'" font-size="14" fill="var(--orange)" font-weight="700">p_t = '+fmt(P,0)+' kPa</text>';
  svg.innerHTML=s;
}
[pt,spd,film,tread].forEach(function(el){el.addEventListener('input',render)});
